CRM_BASE_URL=https://apihide.com/bitrix/calendar/
# Calendar API date timezone (Docker defaults to UTC; CRM expects Moscow)
CRM_TIMEZONE=Europe/Moscow
CRM_LOGIN=
CRM_PASSWORD=

# Tony (crm.apihide.com) — order source of truth
TONY_BASE_URL=https://crm.apihide.com
TONY_LOGIN=
TONY_PASSWORD=
# Legacy sequential pipeline only; parallel prefetch ignores this delay
TONY_REQUEST_DELAY_MS=350

# Parsing pipeline
# Max simultaneous HTTP requests during parallel prefetch (not “N deals at once”)
FETCH_CONCURRENCY=4
# parallel | legacy (sequential, uses TONY_REQUEST_DELAY_MS between requests)
PARSE_PIPELINE=parallel

LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# Docker: join twenty_default (see docker-compose networks) and use internal hostname
TWENTY_API_URL=http://twenty-server:3000/graphql
TWENTY_API_TOKEN=
TWENTY_API_TIMEOUT_MS=60000
# Twenty GraphQL rate limit (default self-hosted: 100 req / 60s)
TWENTY_API_RATE_LIMIT_MAX=95
TWENTY_API_RATE_LIMIT_WINDOW_MS=60000
# External Docker network where Twenty runs (default compose project name: twenty_default)
TWENTY_DOCKER_NETWORK=twenty_default

SESSION_SECRET=change-me
# If set, the web UI and API require this password to access
APP_PASSWORD=
# Service-to-service secret for BrandingTelegram import-by-booking (Bearer token)
IMPORT_API_SECRET=
# BrandingTwentyView → /api/twenty/* (gear menu, line-item lists). If empty, auth is disabled.
TWENTY_APP_API_SECRET=
# Twenty app origin for CORS on /api/twenty (e.g. https://crm.example.com)
TWENTY_APP_CORS_ORIGIN=
PORT=3000

# Public HTTPS origin for Telegram webhook (no trailing slash), e.g. https://crmparser.example.com
PUBLIC_BASE_URL=

# GramJS user-bot (auto-invite): api_id + api_hash from https://my.telegram.org
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# StringSession from backend/scripts/telegram-userbot-login.mjs (never commit real values)
# TELEGRAM_USER_SESSION=
# Proxy for Telegram traffic when direct access is blocked (xray sidecar, ops/telegram-userbot.md §8)
# TELEGRAM_PROXY_URL=socks5://xray:1080
# TELEGRAM_HTTP_PROXY_URL=http://xray:1081
# Long polling instead of webhook (when Telegram cannot reach PUBLIC_BASE_URL)
# TELEGRAM_POLLING=true

# SQLite path inside container (/app/data/crmparser.db when using docker-compose volume)
# DB_PATH=./data/crmparser.db

PRINT_SHEET_ID=12rGgW0vucmm4eXy4yrtQLRLNcqNpPVznpNdA-c1HuP0
# Optional JSON override for department UUID → sheet tab name (defaults to backend/config/print-sheet-departments.json)
# PRINT_SHEET_DEPARTMENT_MAP={"8814cccb-471e-4d05-90cb-261a9395ada8":"Про"}
# Freza queue sheet — prefer Settings UI key freza_sheet_id (leave empty until cycle is live)
# FREZA_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
PRINT_SHEET_CACHE_TTL_MS=60000
